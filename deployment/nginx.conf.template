limit_req_zone $binary_remote_addr zone=quotes:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=adminlogin:10m rate=10r/m;
server {
  listen 80;
  server_name ${SITE_HOST};
  return 301 https://${SITE_HOST}$request_uri;
}
server {
  listen 443 ssl;
  server_name ${SITE_HOST};
  ssl_certificate /etc/letsencrypt/live/${SITE_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SITE_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 21m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  location = /api/quote {
    limit_req zone=quotes burst=3 nodelay;
    limit_req_status 429;
    proxy_pass http://app:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
  location = /api/users/login {
    limit_req zone=adminlogin burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://app:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
  location / {
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }
}
