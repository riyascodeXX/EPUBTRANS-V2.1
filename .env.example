DATABASE_URL=postgresql://epubtrans:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/epubtrans
PAYLOAD_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
PREVIEW_SECRET=GENERATE_A_DISTINCT_RANDOM_SECRET
PRIVATE_UPLOAD_DIR=private-uploads
TRUST_NGINX_PROXY=false
# Optional: Google Cloud Translation Basic API key, kept server-side. MyMemory is used without a key.
GOOGLE_TRANSLATE_API_KEY=
TRANSLATION_DAILY_CHARACTER_LIMIT=250000
